
// GPIO
`define GPIO_CELL           PRDW0408CDG
`define GPIO_SDA_CELL       PRUW0408CDG

// Digital
`define DIGITAL_IO_CELL  PRDW0408CDG

// Analog
`define ANALOG_IO_CELL      PDB3A
`define ANALOG_P_CELL       PVDD2CDG


// Power / Ground
`define POWER_IO_CELL       PVDD2CDG
`define GROUND_IO_CELL      PVSS2CDG

// Reset / Clock
`define RESET_IO_CELL       PRUW0408CDG
`define CLOCK_IO_CELL       PXOE1CDG
